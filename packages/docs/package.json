{
	"name": "react-socket-docs",
	"version": "0.0.1",
	"description": "Documentation and demo site for react-socket.",
	"private": true,
	"scripts": {
		"dev": "astro dev",
		"build": "astro build && bunx pagefind --site dist --output-subdir _pagefind",
		"preview": "wrangler dev",
		"deploy": "astro build && bunx pagefind --site dist --output-subdir _pagefind && wrangler deploy",
		"dev:server": "bun run server/dev-ws.ts"
	},
	"dependencies": {
		"@astrojs/cloudflare": "^12.0.0",
		"@astrojs/react": "^4.0.0",
		"@astrojs/sitemap": "^3.7.1",
		"@luciodale/docs-ui-kit": "^0.2.2",
		"@luciodale/react-socket": "workspace:*",
		"@tailwindcss/vite": "^4.1.18",
		"astro": "^5.0.0",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"tailwindcss": "^4.1.18",
		"zustand": "^5.0.11"
	},
	"devDependencies": {
		"@types/bun": "^1.3.10",
		"@types/react": "^18.0.28",
		"@types/react-dom": "^18.0.11",
		"wrangler": "^4.0.0"
	}
}
