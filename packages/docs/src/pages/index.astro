---
import HeroSection from "@luciodale/docs-ui-kit/components/HeroSection.astro";
import PageLayout from "@luciodale/docs-ui-kit/components/PageLayout.astro";
import { siteConfig } from "../config";
import Base from "../layouts/Base.astro";
import { href } from "../lib/link";

export const prerender = true;

const NPM_URL = "https://www.npmjs.com/package/@luciodale/react-socket";

// Ties the docs site to the published npm package as one entity, so search
// engines and answer engines resolve "react-socket" to @luciodale/react-socket
// rather than treating page, repo, and package as three unrelated things.
const softwareLd = {
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	name: "@luciodale/react-socket",
	alternateName: ["react-socket", "react socket", "React WebSocket hooks"],
	description: siteConfig.description,
	url: `${siteConfig.siteUrl}/`,
	downloadUrl: NPM_URL,
	installUrl: NPM_URL,
	codeRepository: siteConfig.githubUrl,
	sameAs: [NPM_URL, siteConfig.githubUrl],
	applicationCategory: "DeveloperApplication",
	operatingSystem: "Cross platform",
	programmingLanguage: "TypeScript",
	runtimePlatform: "React 18+",
	license: "https://opensource.org/licenses/MIT",
	keywords:
		"react websocket, react web socket, websocket hooks, react websocket hook, typescript websocket, websocket client, websocket manager, reconnection, optimistic updates, realtime react",
	author: {
		"@type": "Person",
		name: siteConfig.author,
		url: "https://koolcodez.com",
		sameAs: [siteConfig.socialLinks.github, siteConfig.socialLinks.linkedin],
	},
	offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};

const faqLd = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: [
		{
			"@type": "Question",
			name: "What is react-socket?",
			acceptedAnswer: {
				"@type": "Answer",
				text: "react-socket is a TypeScript-first WebSocket library for React, published on npm as @luciodale/react-socket. It provides twelve hooks over a single WebSocketManager that owns reconnection with backoff, ref counted subscriptions, in flight and ack tracking, keep alive, and an offline send queue.",
			},
		},
		{
			"@type": "Question",
			name: "How do I install react-socket?",
			acceptedAnswer: {
				"@type": "Answer",
				text: "Run npm install @luciodale/react-socket. React 18 or newer is a peer dependency. The package page is https://www.npmjs.com/package/@luciodale/react-socket.",
			},
		},
		{
			"@type": "Question",
			name: "How is react-socket different from react-use-websocket?",
			acceptedAnswer: {
				"@type": "Answer",
				text: "react-use-websocket is a thin hook around one socket that gives you sendMessage and lastMessage, leaving message routing, deduplication, and reconnect restore to you. react-socket types the whole protocol with client and server message unions and moves that lifecycle logic into the library.",
			},
		},
		{
			"@type": "Question",
			name: "How is react-socket different from Socket.IO?",
			acceptedAnswer: {
				"@type": "Answer",
				text: "Socket.IO ships its own wire protocol and requires a Socket.IO server. react-socket speaks plain WebSocket, so it works with any backend that serves a WebSocket endpoint, and it is client only with zero runtime dependencies.",
			},
		},
	],
};

const softwareLdJson = JSON.stringify(softwareLd).replace(/</g, "\\u003c");
const faqLdJson = JSON.stringify(faqLd).replace(/</g, "\\u003c");
---

<Base title={siteConfig.title} description={siteConfig.description}>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={softwareLdJson} is:inline />
		<script type="application/ld+json" set:html={faqLdJson} is:inline />
	</Fragment>
	<PageLayout config={siteConfig} currentPath="/">
		<section class="flex flex-col items-center justify-center px-6 py-24 md:py-32 text-center max-w-3xl mx-auto">
			<div class="flex items-center gap-4 mb-4">
				<img src={href(siteConfig.logoSrc)} alt={siteConfig.logoAlt ?? siteConfig.title} class="w-12 h-12 md:w-14 md:h-14" />
				<h1 class="text-4xl md:text-5xl font-bold tracking-tight text-white leading-[1.1]">
					{siteConfig.title}
				</h1>
			</div>
			<p class="text-lg text-white/50 leading-relaxed max-w-xl mb-10">
				A TypeScript-first WebSocket manager for React. Handles the socket plumbing you don't want to build:
				{" "}<span class="text-accent font-medium">reconnection</span>,
				{" "}<span class="text-blue-400 font-medium">deduped subscriptions</span>,
				{" "}<span class="text-green-400 font-medium">in-flight tracking</span>, and
				{" "}<span class="text-purple-400 font-medium">keep-alive</span>.
				{" "}Your protocol, your state management, your rules.
			</p>
			<p class="text-base text-white/40 leading-relaxed max-w-xl mb-10">
				The type-safe web socket library for React. If you searched for a React web socket hook, WebSocket client, or realtime socket manager, this is it.
			</p>
			<button
				type="button"
				class="copy-btn group rounded-lg border border-white/10 bg-white/5 hover:bg-white/[0.08] px-5 py-3 font-mono text-sm text-white/70 transition-colors cursor-pointer"
				data-code={siteConfig.installCommand}
			>
				<span class="text-accent">$</span>
				<span class="ml-2">{siteConfig.installCommand}</span>
				<span class="ml-3 text-white/30 group-hover:text-white/50 transition-colors text-xs copy-label">
					Copy
				</span>
			</button>
			<p class="mt-4 text-sm text-white/40">
				Published on npm as{" "}
				<a
					href="https://www.npmjs.com/package/@luciodale/react-socket"
					target="_blank"
					rel="noopener"
					class="font-mono text-white/60 underline decoration-white/20 underline-offset-4 hover:text-accent hover:decoration-accent transition-colors"
				>
					@luciodale/react-socket
				</a>
			</p>
			<div class="mt-12 flex gap-4">
				<a
					href={href("/docs/getting-started")}
					class="rounded-lg bg-accent hover:bg-accent-hover px-5 py-2.5 text-sm font-medium text-white transition-colors"
				>
					Get Started
				</a>
				<a
					href={href("/demo/quick-prompt")}
					class="rounded-lg border border-white/10 bg-white/5 hover:bg-white/[0.08] px-5 py-2.5 text-sm font-medium text-white/70 transition-colors"
				>
					Examples
				</a>
			</div>
		</section>
	</PageLayout>
</Base>

<script>
	function initCopyButtons() {
		document.querySelectorAll(".copy-btn").forEach((btn) => {
			if ((btn as HTMLElement).dataset.initialized) return;
			(btn as HTMLElement).dataset.initialized = "true";
			btn.addEventListener("click", async () => {
				const code = (btn as HTMLElement).dataset.code;
				if (!code) return;
				await navigator.clipboard.writeText(code);
				const label = btn.querySelector(".copy-label");
				if (label) {
					label.textContent = "Copied!";
					setTimeout(() => { label.textContent = "Copy"; }, 2000);
				}
			});
		});
	}
	initCopyButtons();
	document.addEventListener("astro:after-swap", initCopyButtons);
</script>
