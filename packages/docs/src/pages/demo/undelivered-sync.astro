---
import CodeBlock from "@luciodale/docs-ui-kit/components/CodeBlock.astro";
import ContentSection from "@luciodale/docs-ui-kit/components/ContentSection.astro";
import InlineCode from "@luciodale/docs-ui-kit/components/InlineCode.astro";
import { UndeliveredSync } from "../../components/demos/UndeliveredSync";
import DocsPage from "../../layouts/DocsPage.astro";

export const prerender = true;
---

<DocsPage title="Undelivered Sync" description="Demonstrates message persistence: send messages, disconnect, and retry them manually when ready.">
	<ContentSection label="Undelivered Sync">
		<p class="text-white/60 mb-6 leading-relaxed">
			This demo shows what happens when you send messages while disconnected.
			Messages are saved to localStorage and marked as failed. You decide when
			to retry them by clicking the retry button next to each message.
		</p>
	</ContentSection>

	<ContentSection label="Live Demo">
		<p class="text-white/60 mb-4 leading-relaxed">
			Hit <strong class="text-white/80">Disconnect</strong>, send a few messages (they'll
			be saved immediately), then hit <strong class="text-white/80">Reconnect</strong>.
			Failed messages show a retry button. Click it to resend:
			<InlineCode>failed</InlineCode> &rarr;
			<InlineCode>retrying</InlineCode> &rarr;
			<InlineCode>delivered</InlineCode>.
		</p>
		<UndeliveredSync client:load />
	</ContentSection>

	<ContentSection label="Persistence Setup">
		<p class="text-white/60 mb-4 leading-relaxed">
			Create an undelivered store backed by localStorage. Messages are keyed by
			channel and deduplicated by ID:
		</p>
		<CodeBlock
			code={`import {
  createUndeliveredSync,
  createLocalStorage,
} from "@luciodale/react-socket";

type TStoredMessage = { id: string; channel: string; text: string };

const undelivered = createUndeliveredSync<TStoredMessage>({
  storage: createLocalStorage(),
  storageKey: "react_socket_demo_undelivered",
});

// Load any previously saved messages before connecting
await undelivered.init();`}
			language="tsx"
			filename="UndeliveredSync.tsx"
		/>
	</ContentSection>

	<ContentSection label="Saving Undelivered Messages">
		<p class="text-white/60 mb-4 leading-relaxed">
			Messages can fail to deliver in two ways. If the connection drops mid-send,
			<InlineCode>onInFlightDrop</InlineCode> fires and you save
			the dropped messages. If the user sends while already disconnected,
			<InlineCode>send()</InlineCode> returns
			<InlineCode>false</InlineCode> and you save immediately:
		</p>
		<CodeBlock
			code={`// Path 1: connection drops while messages are in-flight
onInFlightDrop(messages) {
  for (const { id, data } of messages) {
    if (data.action === "message") {
      undelivered.addMessage(data.channel, {
        id,
        channel: data.channel,
        text: data.text,
      });
    }
  }
}

// Path 2: user sends while already disconnected
function handleSend(channel: string, text: string) {
  const id = crypto.randomUUID();
  const sent = manager.send({
    data: { action: "message", id, channel, text },
    ackId: id,
  });
  if (!sent) {
    undelivered.addMessage(channel, { id, channel, text });
  }
}`}
			language="tsx"
			filename="UndeliveredSync.tsx"
		/>
	</ContentSection>

	<ContentSection label="Manual Retry">
		<p class="text-white/60 mb-4 leading-relaxed">
			Failed messages stay visible with a retry button. When the user clicks it,
			you resend the message through the manager. If the connection is back up,
			the message transitions through
			<InlineCode>retrying</InlineCode> &rarr;
			<InlineCode>delivered</InlineCode>:
		</p>
		<CodeBlock
			code={`function handleRetry(id: string, text: string) {
  const sent = manager.send({
    data: { action: "message", id, channel: "demo", text },
    ackId: id,
  });
  if (!sent) {
    // Still disconnected, keep it as failed
  }
}

// When the server confirms, clean up:
onMessageReceived(msg) {
  if (msg.action === "message") {
    manager.ackInFlight(msg.id);
    undelivered.removeMessage(msg.channel, msg.id);
  }
}`}
			language="tsx"
			filename="UndeliveredSync.tsx"
		/>
	</ContentSection>
</DocsPage>
