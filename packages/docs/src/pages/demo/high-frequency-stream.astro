---
import Callout from "@luciodale/docs-ui-kit/components/Callout.astro";
import CodeBlock from "@luciodale/docs-ui-kit/components/CodeBlock.astro";
import ContentSection from "@luciodale/docs-ui-kit/components/ContentSection.astro";
import InlineCode from "@luciodale/docs-ui-kit/components/InlineCode.astro";
import { HighFrequencyStream } from "../../components/demos/HighFrequencyStream";
import DocsPage from "../../layouts/DocsPage.astro";
import { href } from "../../lib/link";

export const prerender = true;

const perEventSample = `// One render per tick. At 50 ticks/sec that is 50 renders/sec.
useSocketEvent(manager, "tick", (msg) => {
  setLatest(msg);
  setReceived((n) => n + 1);
});`;

const batchedSample = `// One render per flush window. flushMs: 100 caps renders at 10/sec
// regardless of inbound rate.
useSocketEventBatch(
  manager,
  "tick",
  (msgs) => {
    if (msgs.length === 0) return;
    setReceived((n) => n + msgs.length);
    setLatest(msgs[msgs.length - 1]);
  },
  { flushMs: 100 },
);`;
---

<DocsPage
	title="High-frequency stream"
	description="Side-by-side comparison of useSocketEvent vs useSocketEventBatch on a 50-ticks-per-second stream."
>
	<ContentSection label="High-frequency stream">
		<p class="text-white/60 mb-4 leading-relaxed">
			A 50 ticks-per-second stream rendered two ways. The left panel
			re-renders on every tick. The right panel batches and flushes once
			every 100ms. Same data, six times fewer renders.
		</p>
		<p class="text-white/60 leading-relaxed">
			Watch the <strong>Renders</strong> counters diverge once you press
			start. The Received counts stay equal because no events are dropped
			either way.
		</p>
	</ContentSection>

	<ContentSection label="Live demo">
		<HighFrequencyStream client:load />
	</ContentSection>

	<ContentSection label="Per-event handler">
		<CodeBlock code={perEventSample} language="tsx" filename="HighFrequencyStream.tsx" />
		<p class="text-white/60 mt-4 leading-relaxed">
			Fine for slow streams (a few events per second). Disastrous for
			anything ten or higher.
		</p>
	</ContentSection>

	<ContentSection label="Batched handler">
		<CodeBlock code={batchedSample} language="tsx" filename="HighFrequencyStream.tsx" />
		<Callout type="tip" title="flushMs is required">
			There is no default. Pick a value that matches the responsiveness you
			want. 16ms feels live, 100ms feels responsive, 250ms+ is clearly
			batched. See the
			<a href={href("/docs/backpressure")} class="text-accent hover:underline"> Backpressure</a> guide.
		</Callout>
	</ContentSection>

	<ContentSection label="Related">
		<ul class="space-y-2 text-white/60">
			<li>
				<a href={href("/docs/backpressure")} class="text-accent hover:underline">Backpressure</a> — picking flushMs, ordering, what batching does NOT do
			</li>
			<li>
				<a href={href("/docs/api")} class="text-accent hover:underline">API reference</a> — full <InlineCode>useSocketEventBatch</InlineCode> signature
			</li>
		</ul>
	</ContentSection>
</DocsPage>
