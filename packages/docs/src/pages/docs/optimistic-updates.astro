---
import Callout from "@luciodale/docs-ui-kit/components/Callout.astro";
import CodeBlock from "@luciodale/docs-ui-kit/components/CodeBlock.astro";
import ContentSection from "@luciodale/docs-ui-kit/components/ContentSection.astro";
import InlineCode from "@luciodale/docs-ui-kit/components/InlineCode.astro";
import DocsPage from "../../layouts/DocsPage.astro";
import { href } from "../../lib/link";

export const prerender = true;
---

<DocsPage title="Sending Messages & Optimistic UI">
	<ContentSection label="Two modes">
		<p class="text-white/60 mb-4 leading-relaxed">
			Every outbound message is sent via
			<InlineCode>useSocketSend</InlineCode> (inside React) or
			<InlineCode>manager.send</InlineCode> (outside React). You pick per
			call: fire and forget, or tracked with an
			<InlineCode>ackId</InlineCode>.
		</p>
	</ContentSection>

	<ContentSection label="Fire and forget">
		<p class="text-white/60 mb-4 leading-relaxed">
			Send and move on. Good for cursor positions, typing pings, anything
			where a lost message does not matter because the next one is
			already in flight.
		</p>
		<CodeBlock
			code={`const { send } = useSocketSend(manager);
send({ type: "cursor_move", x: 100, y: 200 });`}
			language="tsx"
			filename="fire-and-forget.tsx"
		/>
	</ContentSection>

	<ContentSection label="Acknowledged send">
		<p class="text-white/60 mb-4 leading-relaxed">
			Pass an <InlineCode>ackId</InlineCode> as the second argument and the
			library tracks the message as in flight. The server must echo back a
			confirmation that carries the same id. Wire the
			<InlineCode>getAckId</InlineCode> extractor in manager config and the
			library clears the tracking automatically — you never call
			<InlineCode>ackInFlight</InlineCode> from user code.
		</p>
		<CodeBlock
			code={`// manager config
{
  getAckId: (msg) => (msg.type === "delivered" ? msg.ackId : undefined),
}`}
			language="tsx"
			filename="manager.ts"
		/>
		<CodeBlock
			code={`function ChatInput({ roomId }: { roomId: string }) {
  const { send } = useSocketSend(manager);

  function onSend(text: string) {
    const id = crypto.randomUUID();
    send({ type: "message", id, roomId, text }, id);
  }

  return <button onClick={() => onSend("hi")}>send</button>;
}`}
			language="tsx"
			filename="ChatInput.tsx"
		/>
	</ContentSection>

	<ContentSection label="Optimistic UI">
		<p class="text-white/60 mb-4 leading-relaxed">
			Three hooks cover the full lifecycle:
			<InlineCode>useSocketSendIntent</InlineCode> fires on every
			<InlineCode>send()</InlineCode>, even offline — insert the
			optimistic record here. <InlineCode>useSocketEvent</InlineCode> on
			the delivered message flips it to "sent."
			<InlineCode>useSocketInFlightDrop</InlineCode> fires when the
			connection drops before ack — mark as failed. Mount them together
			in one bridge component.
		</p>
		<CodeBlock
			code={`const manager = new WebSocketManager<TClientMsg, TServerMsg>({
  url: "wss://...",
  serialize: JSON.stringify,
  deserialize: (raw) => JSON.parse(raw),
  getAckId: (msg) => (msg.type === "delivered" ? msg.ackId : undefined),
});`}
			language="tsx"
			filename="manager.ts"
		/>
		<CodeBlock
			code={`function ChatOptimisticBridge() {
  useSocketSendIntent(manager, ({ data, ackId }) => {
    if (data.type === "message" && ackId) {
      useChatStore.getState().insertOptimistic(data, ackId);
    }
  });

  useSocketEvent(manager, "delivered", (msg) => {
    useChatStore.getState().markDelivered(msg.ackId);
  });

  useSocketInFlightDrop(manager, (messages) => {
    for (const { id } of messages) {
      useChatStore.getState().markFailed(id);
    }
  });

  return null;
}`}
			language="tsx"
			filename="ChatOptimisticBridge.tsx"
		/>
		<Callout type="info">
			Non-React consumers (workers, tests) wire the same logic via
			<InlineCode>manager.addSendIntentListener()</InlineCode> and
			<InlineCode>manager.addInFlightDropListener()</InlineCode>. Both
			return an unsubscribe.
		</Callout>
	</ContentSection>

	<ContentSection label="Disabled UI when offline">
		<p class="text-white/60 mb-4 leading-relaxed">
			Compose <InlineCode>useSocketSend</InlineCode> with
			<InlineCode>useSocketConnectionState</InlineCode>. They are kept
			separate on purpose so components that only need
			<InlineCode>send</InlineCode> do not re render on every state
			transition.
		</p>
		<CodeBlock
			code={`function SendButton() {
  const state = useSocketConnectionState(manager);
  const { send } = useSocketSend(manager);
  const canSend = state === "connected";

  return (
    <button
      disabled={!canSend}
      onClick={() => send({ type: "ping" })}
    >
      ping
    </button>
  );
}`}
			language="tsx"
			filename="SendButton.tsx"
		/>
	</ContentSection>

	<ContentSection label="Persist undelivered">
		<p class="text-white/60 mb-4 leading-relaxed">
			For messages that must survive a page refresh, pair this flow with
			<a href={href("/docs/undelivered-sync")} class="text-accent hover:underline">createUndeliveredSync</a>. Store on send, remove on ack, retry
			on reconnect.
		</p>
	</ContentSection>

	<ContentSection label="Next">
		<ul class="space-y-2 text-white/60">
			<li>
				<a href={href("/docs/patterns")} class="text-accent hover:underline">Patterns</a> — acknowledged send walkthrough
			</li>
			<li>
				<a href={href("/docs/api")} class="text-accent hover:underline">API Reference</a>
			</li>
		</ul>
	</ContentSection>
</DocsPage>
