---
import Callout from "@luciodale/docs-ui-kit/components/Callout.astro";
import CodeBlock from "@luciodale/docs-ui-kit/components/CodeBlock.astro";
import ContentSection from "@luciodale/docs-ui-kit/components/ContentSection.astro";
import InlineCode from "@luciodale/docs-ui-kit/components/InlineCode.astro";
import DocsPage from "../../layouts/DocsPage.astro";
import { href } from "../../lib/link";

export const prerender = true;
---

<DocsPage title="Subscriptions">
	<ContentSection label="Subscriptions">
		<p class="text-white/60 mb-4 leading-relaxed">
			Subscriptions tell the server "I want updates on this stream." The
			library ref counts internally so ten components can all mount a
			<InlineCode>useSocketSubscription</InlineCode> for the same key and
			only one message hits the server. When the last consumer unmounts,
			the unsubscribe fires automatically. After a reconnect, every active
			subscription is restored transparently.
		</p>
	</ContentSection>

	<ContentSection label="The hook">
		<p class="text-white/60 mb-4 leading-relaxed">
			<InlineCode>useSocketSubscription</InlineCode> owns the lifecycle.
			The <InlineCode>key</InlineCode> is the ref counted identifier. The
			<InlineCode>subscribe</InlineCode> and
			<InlineCode>unsubscribe</InlineCode> payloads are typed against
			<InlineCode>TClientMsg</InlineCode>.
		</p>
		<CodeBlock
			code={`useSocketSubscription(manager, {
  key: "chat:general",
  subscribe: { type: "subscribe", channel: "general" },
  unsubscribe: { type: "unsubscribe", channel: "general" },
});`}
			language="tsx"
			filename="basic.tsx"
		/>
	</ContentSection>

	<ContentSection label="Pin the key + payloads in a custom hook (recommended)">
		<p class="text-white/60 mb-4 leading-relaxed">
			Don't call <InlineCode>useSocketSubscription</InlineCode> directly from
			feature components. Wrap it once per resource — same file as the
			resource's protocol — and have every consumer use the wrapper. The
			<InlineCode>key</InlineCode>, the
			<InlineCode>subscribe</InlineCode> payload, and the
			<InlineCode>unsubscribe</InlineCode> payload all derive from the same
			input, so it is impossible for two call sites to drift apart.
		</p>
		<CodeBlock
			code={`// hooks/useSpaceSubscription.ts
import { useSocketSubscription } from "@luciodale/react-socket";
import { manager } from "../socket/manager";

export function useSpaceSubscription(spaceId: string | null) {
  useSocketSubscription(manager, {
    key: spaceId ?? "",
    enabled: spaceId !== null,
    subscribe: spaceId
      ? { type: "subscribe", channel: spaceId }
      : undefined,
    unsubscribe: spaceId
      ? { type: "unsubscribe", channel: spaceId }
      : undefined,
  });
}`}
			language="tsx"
			filename="hooks/useSpaceSubscription.ts"
		/>
		<p class="text-white/60 mt-4 leading-relaxed">
			Now every consumer is a one-liner that cannot get the params wrong:
		</p>
		<CodeBlock
			code={`function SpaceHeader({ spaceId }: { spaceId: string }) {
  useSpaceSubscription(spaceId);
  // ...
}

function MessageList({ spaceId }: { spaceId: string }) {
  useSpaceSubscription(spaceId);
  // ...
}`}
			language="tsx"
			filename="components.tsx"
		/>
		<Callout type="tip" title="Why this matters">
			The library has first-payload-wins semantics: if two components
			subscribe with the same key but different payloads, only the first
			one is sent and replayed on reconnect. Wrapping in a custom hook
			removes the entire class of bug — the payload is computed in one
			place, the same way, every time.
		</Callout>
		<Callout type="info" title="Late joiners and `enabled`">
			A component flipping <InlineCode>enabled: false → true</InlineCode> on a
			key that another component already subscribed to is just a ref-count
			bump — its <InlineCode>subscribe</InlineCode> payload never reaches
			the wire (first-payload wins). If the joiner needs to identify itself,
			send a separate <InlineCode>useSocketSend</InlineCode> message instead
			of relying on the subscribe payload.
		</Callout>
	</ContentSection>

	<ContentSection label="Bookkeeping-only subscribe (no payload)">
		<p class="text-white/60 mb-4 leading-relaxed">
			You can call <InlineCode>useSocketSubscription</InlineCode> with no
			<InlineCode>subscribe</InlineCode> / <InlineCode>unsubscribe</InlineCode>
			payload at all. The ref count still bumps and
			<InlineCode>useSocketLastUnsubscribe</InlineCode> still fires when it
			reaches zero, but nothing goes on the wire.
			<InlineCode>useSocketPendingSubscription</InlineCode> stays
			<InlineCode>false</InlineCode> for those keys (there is no server ack
			to wait for).
		</p>
	</ContentSection>

	<ContentSection label="Ref counting in action">
		<p class="text-white/60 mb-4 leading-relaxed">
			Render the same hook twice in one tree. Only one subscribe hits the
			server; only one unsubscribe fires when both unmount.
		</p>
		<CodeBlock
			code={`function PriceBadge({ ticker }: { ticker: string }) {
  useSocketSubscription(manager, {
    key: \`price:\${ticker}\`,
    subscribe: { type: "subscribe", channel: ticker },
    unsubscribe: { type: "unsubscribe", channel: ticker },
  });
  const price = usePriceStore((s) => s.prices[ticker]);
  return <span>{price}</span>;
}

// Renders N copies → 1 subscribe on the wire, N readers on the store.
<List>
  {tickers.map((t) => <PriceBadge key={t} ticker={t} />)}
</List>`}
			language="tsx"
			filename="PriceBadge.tsx"
		/>
	</ContentSection>

	<ContentSection label="Reading the stream">
		<p class="text-white/60 mb-4 leading-relaxed">
			<InlineCode>useSocketSubscription</InlineCode> manages the server
			side stream. Reading is a separate concern. For streams consumed by
			many components, pair with a single
			<InlineCode>useSocketEvent</InlineCode> bridge that writes into a
			zustand store. See the <a href={href("/docs/patterns")} class="text-accent hover:underline">rendered state from a stream</a> pattern.
		</p>
		<CodeBlock
			code={`// One bridge, shared by all consumers
function PriceBridge() {
  useSocketEvent(manager, "price", (msg) => {
    usePriceStore.getState().set(msg.ticker, msg.value);
  });
  return null;
}`}
			language="tsx"
			filename="PriceBridge.tsx"
		/>
	</ContentSection>

	<ContentSection label="Joining state">
		<p class="text-white/60 mb-4 leading-relaxed">
			Most servers ack a subscribe with a confirmation message. Wire
			<InlineCode>getSubscriptionResolvedKey</InlineCode> in the manager
			config so the library clears the pending marker automatically, then
			read it with <InlineCode>useSocketPendingSubscription</InlineCode>.
		</p>
		<CodeBlock
			code={`// manager config
{
  getSubscriptionResolvedKey: (msg) =>
    msg.type === "subscribe-ack" ? msg.channel : undefined,
}`}
			language="tsx"
			filename="manager.ts"
		/>
		<CodeBlock
			code={`function Room({ id }: { id: string }) {
  useSocketSubscription(manager, {
    key: id,
    subscribe: { type: "subscribe", channel: id },
    unsubscribe: { type: "unsubscribe", channel: id },
  });

  const joining = useSocketPendingSubscription(manager, id);
  if (joining) return <span>joining...</span>;
  return <MessageList roomId={id} />;
}`}
			language="tsx"
			filename="Room.tsx"
		/>
	</ContentSection>

	<ContentSection label="Restoration on reconnect">
		<Callout type="info">
			When the connection drops and comes back, every active subscription
			is replayed to the server using the stored
			<InlineCode>subscribe</InlineCode> payload. Consumers do not need to
			do anything. The pending marker briefly flips back to true during
			restoration, so <InlineCode>useSocketPendingSubscription</InlineCode>
			reflects reality even across reconnects.
		</Callout>
	</ContentSection>

	<ContentSection label="Subscribe only, no read">
		<p class="text-white/60 mb-4 leading-relaxed">
			Sometimes a component needs the server to keep a stream alive but
			does not render from it (presence keepalive, typing indicator host).
			That is fine — subscribing and reading are independent.
		</p>
		<CodeBlock
			code={`function PresenceKeepalive() {
  useSocketSubscription(manager, {
    key: "presence",
    subscribe: { type: "sub-presence" },
    unsubscribe: { type: "unsub-presence" },
  });
  return null;
}`}
			language="tsx"
			filename="PresenceKeepalive.tsx"
		/>
	</ContentSection>

	<ContentSection label="Next">
		<ul class="space-y-2 text-white/60">
			<li>
				<a href={href("/docs/patterns")} class="text-accent hover:underline">Patterns</a> — history, optimistic sends, composition
			</li>
			<li>
				<a href={href("/docs/api")} class="text-accent hover:underline">API Reference</a>
			</li>
		</ul>
	</ContentSection>
</DocsPage>
