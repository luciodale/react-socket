---
import Callout from "@luciodale/docs-ui-kit/components/Callout.astro";
import CodeBlock from "@luciodale/docs-ui-kit/components/CodeBlock.astro";
import ContentSection from "@luciodale/docs-ui-kit/components/ContentSection.astro";
import InlineCode from "@luciodale/docs-ui-kit/components/InlineCode.astro";
import PropsTable from "@luciodale/docs-ui-kit/components/PropsTable.astro";
import DocsPage from "../../layouts/DocsPage.astro";
import { href } from "../../lib/link";

export const prerender = true;
---

<DocsPage title="Configuration">
	<ContentSection label="Configuration">
		<p class="text-white/60 mb-4 leading-relaxed">
			The manager is configured through a single options object. Three fields
			are required: URL and a pair of serialization functions. Everything
			else has sensible defaults. Every option is typed against your client
			and server message generics.
		</p>
	</ContentSection>

	<ContentSection label="Options at a glance">
		<PropsTable
			rows={[
				{ name: "url", type: "string | (() => string | Promise<string>)", description: "WebSocket endpoint URL. Pass a function to resolve it per connect (e.g. auth tokens)", required: true },
				{ name: "serialize", type: "(msg: TClientMsg) => string", description: "Convert outgoing messages to strings", required: true },
				{ name: "deserialize", type: "(raw: string) => TServerMsg", description: "Parse incoming strings into typed messages", required: true },
				{ name: "discriminator", type: "string", defaultValue: '"type"', description: "Key used to narrow TServerMsg in useSocketEvent" },
				{ name: "getAckId", type: "(msg: TServerMsg) => string | undefined", description: "Return the ack id when an incoming message confirms an outbound send. Library auto-clears the matching in-flight entry" },
				{ name: "getSubscriptionResolvedKey", type: "(msg: TServerMsg) => string | undefined", description: "Return the subscription key when an incoming message confirms a subscribe. Library auto-clears the pending marker" },
				{ name: "ping", type: "() => TClientMsg", description: "Function returning the ping message, called each interval" },
				{ name: "isPong", type: "(msg: TServerMsg) => boolean", description: "Return true if an incoming message is a pong" },
				{ name: "pingIntervalMs", type: "number", defaultValue: "30000", description: "Milliseconds between pings" },
				{ name: "pongTimeoutMs", type: "number", defaultValue: "10000", description: "Milliseconds to wait for a pong before disconnecting" },
				{ name: "reconnectMaxAttempts", type: "number", defaultValue: "5", description: "Maximum reconnection attempts" },
				{ name: "reconnectBaseDelayMs", type: "number", defaultValue: "1000", description: "Initial reconnection delay" },
				{ name: "reconnectMaxDelayMs", type: "number", defaultValue: "5000", description: "Maximum reconnection delay" },
				{ name: "transport", type: "IWebSocketTransport", description: "Custom WebSocket transport for testing or non-browser environments" },
				{ name: "binaryType", type: '"blob" | "arraybuffer"', description: "Tell the transport which binary type to deliver. Required when sending or receiving binary frames; widen the manager's TWire / TIncoming generics accordingly" },
				{ name: "onSendIntent", type: "(params: TSendParams) => void", description: "Fires on every send(), even when offline. Use for optimistic UI" },
				{ name: "onConnectionStateChange", type: "(state: TConnectionState) => void", description: "Fires when connection state changes" },
				{ name: "onReady", type: "(restoredKeys: string[]) => void", description: "Fires after (re)connect once subscriptions are restored. Receives the list of keys the library replayed" },
				{ name: "onInFlightDrop", type: "(messages) => void", description: "Fires when in-flight messages are dropped on disconnect" },
				{ name: "onLastUnsubscribe", type: "(key, data) => void", description: "Fires when the last subscriber for a key leaves" },
				{ name: "onDebug", type: "(event: TDebugEvent) => void", description: "Fires for every internal event" },
			]}
		/>
	</ContentSection>

	<ContentSection label="Required options">
		<CodeBlock
			code={`const manager = new WebSocketManager<TClientMsg, TServerMsg>({
  url: "wss://api.example.com/ws",
  serialize: (msg) => JSON.stringify(msg),
  deserialize: (raw) => JSON.parse(raw),
});`}
			language="tsx"
			filename="manager.ts"
		/>
		<p class="text-white/60 mt-4 leading-relaxed">
			<InlineCode>serialize</InlineCode> and
			<InlineCode>deserialize</InlineCode> are typed against your generics,
			so TypeScript catches shape mismatches. Swap JSON for MessagePack,
			Protobuf, or anything else without touching the rest of your code.
		</p>
	</ContentSection>

	<ContentSection label="Discriminator">
		<p class="text-white/60 mb-4 leading-relaxed">
			<InlineCode>useSocketEvent</InlineCode> narrows server messages by one
			field. The default is <InlineCode>"type"</InlineCode>. Override by
			passing the key as the third generic plus the
			<InlineCode>discriminator</InlineCode> option:
		</p>
		<CodeBlock
			code={`type TServerMsg =
  | { kind: "notification"; title: string }
  | { kind: "user-typing"; userId: string };

const manager = new WebSocketManager<TClientMsg, TServerMsg, "kind">({
  url: "wss://...",
  discriminator: "kind",
  serialize: (msg) => JSON.stringify(msg),
  deserialize: (raw) => JSON.parse(raw) as TServerMsg,
});

useSocketEvent(manager, "notification", (msg) => {
  msg.title; // narrowed
});`}
			language="tsx"
			filename="discriminator.ts"
		/>
		<Callout type="tip">
			If your wire shape uses a non conventional key but you would rather
			keep library defaults, map at the <InlineCode>deserialize</InlineCode> boundary instead: <InlineCode>{"{ type: parsed.kind, ...rest }"}</InlineCode>. One place, done.
		</Callout>
	</ContentSection>

	<ContentSection label="Lifecycle extractors">
		<p class="text-white/60 mb-4 leading-relaxed">
			Two extractors let the library auto wire ack and subscription
			resolution. When either returns a string, the matching internal
			bookkeeping fires before your listeners run. You never call
			<InlineCode>ackInFlight</InlineCode> or
			<InlineCode>resolvePendingSubscription</InlineCode> from user code.
		</p>
		<CodeBlock
			code={`{
  // When the server confirms an outbound send, return its ack id.
  // Library removes the matching in-flight entry automatically.
  getAckId: (msg) => (msg.type === "delivered" ? msg.ackId : undefined),

  // When the server confirms a subscribe, return the subscription key.
  // Library clears the pending marker automatically —
  // useSocketPendingSubscription flips to false.
  getSubscriptionResolvedKey: (msg) =>
    msg.type === "subscribe-ack" ? msg.channel : undefined,
}`}
			language="tsx"
			filename="extractors.ts"
		/>
	</ContentSection>

	<ContentSection label="Ping / pong">
		<p class="text-white/60 mb-4 leading-relaxed">
			Keep alive pings prevent idle connections from being killed by proxies
			or load balancers. <InlineCode>ping</InlineCode> is a function so you
			can include a fresh timestamp each tick.
		</p>
		<CodeBlock
			code={`{
  ping: () => ({ type: "ping", timestamp: Date.now() }),
  isPong: (msg) => msg.type === "pong",
  pingIntervalMs: 30_000,
  pongTimeoutMs: 10_000,
}`}
			language="tsx"
			filename="ping.ts"
		/>
		<Callout type="info">
			If <InlineCode>isPong</InlineCode> is set and the server does not
			respond within <InlineCode>pongTimeoutMs</InlineCode>, the connection
			closes and reconnection begins automatically.
		</Callout>
	</ContentSection>

	<ContentSection label="Reconnection">
		<p class="text-white/60 mb-4 leading-relaxed">
			Exponential backoff with jitter, capped. See the
			<a href={href("/docs/reconnection")} class="text-accent hover:underline">Reconnection</a> guide.
		</p>
		<CodeBlock
			code={`{
  reconnectMaxAttempts: 5,
  reconnectBaseDelayMs: 1_000,
  reconnectMaxDelayMs: 5_000,
}`}
			language="tsx"
			filename="reconnection.ts"
		/>
	</ContentSection>

	<ContentSection label="Callbacks vs hooks">
		<p class="text-white/60 mb-4 leading-relaxed">
			Five of the optional callbacks (<InlineCode>onSendIntent</InlineCode>,
			<InlineCode>onInFlightDrop</InlineCode>,
			<InlineCode>onReady</InlineCode>,
			<InlineCode>onLastUnsubscribe</InlineCode>,
			<InlineCode>onConnectionStateChange</InlineCode>) have hook wrappers:
			<InlineCode>useSocketSendIntent</InlineCode>,
			<InlineCode>useSocketInFlightDrop</InlineCode>,
			<InlineCode>useSocketReady</InlineCode>,
			<InlineCode>useSocketLastUnsubscribe</InlineCode>,
			<InlineCode>useSocketConnectionState</InlineCode>. Both layers fire
			additively. Inside React prefer the hooks for component scoped
			logic; fall back to callbacks for non React consumers or
			bootstrap logic. See
			<a href={href("/docs/getting-started#two-layers-callback-config-and-hook-wrappers")} class="text-accent hover:underline">Two layers</a>.
		</p>
	</ContentSection>

	<ContentSection label="Optional callbacks">
		<CodeBlock
			code={`{
  // Fires on every send(), even when offline. Optimistic UI goes here.
  onSendIntent({ data, ackId }) {
    if (data.type === "message" && ackId) {
      store.addOptimistic(data, ackId);
    }
  },

  // Connection state transitions.
  onConnectionStateChange(state) {
    console.log("ws:", state);
  },

  // Fires after (re)connect once subscriptions are restored.
  // restoredKeys is the list of subscriptions the library replayed.
  onReady(restoredKeys) {
    refetchInbox();
    console.log("restored:", restoredKeys);
  },

  // In-flight messages that never got confirmed before a disconnect.
  onInFlightDrop(messages) {
    for (const { id } of messages) store.markFailed(id);
  },

  // Last subscriber for a key left. Clean up related state.
  onLastUnsubscribe(key) {
    store.clearChannel(key);
  },

  // Every internal event — useful for debugging / inspector.
  onDebug(event) {
    console.log(event.type, event);
  },
}`}
			language="tsx"
			filename="callbacks.ts"
		/>
	</ContentSection>

	<ContentSection label="Custom transport">
		<p class="text-white/60 mb-4 leading-relaxed">
			Default transport is the browser's native
			<InlineCode>WebSocket</InlineCode>. Implement
			<InlineCode>IWebSocketTransport</InlineCode> for tests or non browser
			environments.
		</p>
		<CodeBlock
			code={`import type { IWebSocketTransport } from "@luciodale/react-socket";

const customTransport: IWebSocketTransport = {
  connect(url, protocols) { /* ... */ },
  disconnect(code, reason) { /* ... */ },
  send(data) { /* ... */ },
  readyState: 0,
  onopen: null,
  onclose: null,
  onmessage: null,
  onerror: null,
};

new WebSocketManager<TClientMsg, TServerMsg>({
  url: "wss://...",
  serialize: (msg) => JSON.stringify(msg),
  deserialize: (raw) => JSON.parse(raw),
  transport: customTransport,
});`}
			language="tsx"
			filename="custom-transport.ts"
		/>
		<Callout type="tip" title="Use MockTransport for tests">
			You almost never need to roll your own. Import
			<InlineCode>MockTransport</InlineCode> from
			<InlineCode>@luciodale/react-socket/testing</InlineCode> and pass it as
			<InlineCode>transport</InlineCode>. It captures every send and exposes
			<InlineCode>simulateOpen</InlineCode> /
			<InlineCode>simulateMessage</InlineCode> /
			<InlineCode>simulateClose</InlineCode> for synchronous lifecycle control
			in unit tests. See the
			<a href={href("/docs/testing")} class="text-accent hover:underline"> Testing</a> page.
		</Callout>
	</ContentSection>

	<ContentSection label="Next">
		<ul class="space-y-2 text-white/60">
			<li>
				<a href={href("/docs/api")} class="text-accent hover:underline">API Reference</a> — hooks and manager surface
			</li>
			<li>
				<a href={href("/docs/patterns")} class="text-accent hover:underline">Patterns</a> — scenario driven examples
			</li>
			<li>
				<a href={href("/docs/testing")} class="text-accent hover:underline">Testing</a> — MockTransport, simulating lifecycle, hook tests
			</li>
		</ul>
	</ContentSection>
</DocsPage>
