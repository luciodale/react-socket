---
import Callout from "@luciodale/docs-ui-kit/components/Callout.astro";
import CodeBlock from "@luciodale/docs-ui-kit/components/CodeBlock.astro";
import ContentSection from "@luciodale/docs-ui-kit/components/ContentSection.astro";
import FeatureList from "@luciodale/docs-ui-kit/components/FeatureList.astro";
import InlineCode from "@luciodale/docs-ui-kit/components/InlineCode.astro";
import DocsPage from "../../layouts/DocsPage.astro";
import { href } from "../../lib/link";

export const prerender = true;
---

<DocsPage title="Reconnection">
	<ContentSection label="Reconnection">
		<p class="text-white/60 mb-6 leading-relaxed">
			When a connection drops unexpectedly, the manager automatically attempts to
			reconnect. Subscriptions are restored, in-flight messages are cleaned up,
			and your app stays in sync.
		</p>
	</ContentSection>

	<ContentSection label="How It Works">
		<p class="text-white/60 mb-4 leading-relaxed">
			On an unexpected close (any code other than 1000), the manager:
		</p>
		<ol class="list-decimal list-inside space-y-2 text-white/60 mb-4">
			<li>Sets the state to <InlineCode>"reconnecting"</InlineCode></li>
			<li>Drops any in-flight messages and notifies <InlineCode>useSocketInFlightDrop</InlineCode> listeners</li>
			<li>Waits using exponential backoff with jitter</li>
			<li>Opens a new connection</li>
			<li>Re-sends all active subscriptions</li>
			<li>Fires <InlineCode>onReady</InlineCode></li>
		</ol>
		<p class="text-white/60 leading-relaxed">
			If <InlineCode>disconnect()</InlineCode> was called, or the server
			closed with code 1000 (normal close), no reconnection is attempted.
		</p>
	</ContentSection>

	<ContentSection label="Exponential Backoff">
		<p class="text-white/60 mb-4 leading-relaxed">
			Each retry waits longer than the last, with a random jitter to prevent
			all clients from reconnecting at the same instant:
		</p>
		<CodeBlock
			code={`delay = min(baseDelay * 2^attempt + random jitter, maxDelay)`}
			language="text"
			filename="formula"
		/>
		<p class="text-white/60 mt-4 mb-4 leading-relaxed">
			With the default settings:
		</p>
		<ul class="list-disc list-inside space-y-2 text-white/60">
			<li>Attempt 1: ~1s</li>
			<li>Attempt 2: ~2s</li>
			<li>Attempt 3: ~4s</li>
			<li>Attempt 4: ~5s (capped)</li>
			<li>Attempt 5: ~5s (capped) — last attempt</li>
		</ul>
	</ContentSection>

	<ContentSection label="Configuration">
		<CodeBlock
			code={`const manager = new WebSocketManager<TClientMsg, TServerMsg>({
  // ...

  // Maximum number of reconnect attempts (default: 5)
  reconnectMaxAttempts: 5,

  // Initial delay before the first retry (default: 1000ms)
  reconnectBaseDelayMs: 1_000,

  // Maximum delay between retries (default: 5000ms)
  reconnectMaxDelayMs: 5_000,
});`}
			language="tsx"
			filename="manager.ts"
		/>
		<Callout type="warning">
			After exhausting all attempts, the state moves to
			<InlineCode>"disconnected"</InlineCode> and no further retries are made.
			Call <InlineCode>connect()</InlineCode> or <InlineCode>forceReconnect()</InlineCode> to try again manually.
		</Callout>
	</ContentSection>

	<ContentSection label="Online / Offline Detection">
		<p class="text-white/60 mb-4 leading-relaxed">
			The manager listens to the browser's
			<InlineCode>online</InlineCode> and
			<InlineCode>offline</InlineCode> events:
		</p>
		<FeatureList features={[
			{ highlight: "Offline", description: "the connection is immediately closed and the state moves to \"reconnecting\"", color: "yellow" },
			{ highlight: "Online", description: "the reconnect attempt counter resets to zero and a new connection attempt starts immediately (no backoff delay)", color: "blue" },
		]} />
		<Callout type="tip" title="Instant Recovery">
			When the browser fires the <InlineCode>online</InlineCode> event, the reconnect counter
			resets to zero and a connection attempt starts immediately with no backoff delay.
		</Callout>
	</ContentSection>

	<ContentSection label="Force Reconnect">
		<p class="text-white/60 mb-4 leading-relaxed">
			Sometimes you need to tear everything down and start fresh — for example after
			a token refresh or when switching authenticated contexts:
		</p>
		<CodeBlock
			code={`manager.forceReconnect();`}
			language="tsx"
			filename="reconnect.ts"
		/>
		<p class="text-white/60 mt-4 leading-relaxed">
			This drops all in-flight messages, clears pending subscriptions, closes
			the current connection, resets the attempt counter to zero, and immediately
			calls <InlineCode>connect()</InlineCode>.
		</p>
	</ContentSection>

	<ContentSection label="Subscription Restoration">
		<p class="text-white/60 mb-4 leading-relaxed">
			After reconnecting, the manager re-sends all active subscriptions using the
			<InlineCode>data</InlineCode> payload you passed to
			<InlineCode>subscribe()</InlineCode>. Your components don't need
			to track or re-trigger anything.
		</p>
		<p class="text-white/60 leading-relaxed">
			The <InlineCode>onReady</InlineCode> callback fires after all
			subscriptions have been re-sent. Use it to fetch any data you may have missed
			while disconnected:
		</p>
		<CodeBlock
			code={`const manager = new WebSocketManager<TClientMsg, TServerMsg>({
  // ...
  onReady() {
    // Connection is open and subscriptions are restored.
    // Good place to sync any missed state.
    console.log("Reconnected and ready");
  },
});`}
			language="tsx"
			filename="manager.ts"
		/>
	</ContentSection>

	<ContentSection label="Connection States">
		<p class="text-white/60 mb-4 leading-relaxed">
			Track the connection state in your UI with the
			<InlineCode>useSocketConnectionState</InlineCode> hook:
		</p>
		<CodeBlock
			code={`import { useSocketConnectionState } from "@luciodale/react-socket";

function ConnectionStatus() {
  const state = useSocketConnectionState(manager);

  const labels = {
    disconnected: "Offline",
    connecting: "Connecting...",
    connected: "Connected",
    reconnecting: "Reconnecting...",
  } as const;

  return <span>{labels[state]}</span>;
}`}
			language="tsx"
			filename="ConnectionStatus.tsx"
		/>
	</ContentSection>

	<ContentSection label="Next Steps">
		<ul class="space-y-2 text-white/60">
			<li>
				<a href={href("/docs/subscriptions")} class="text-accent hover:underline">Subscriptions</a> — how ref-counting works
			</li>
			<li>
				<a href={href("/docs/optimistic-updates")} class="text-accent hover:underline">Optimistic Updates</a> — handling in-flight messages on disconnect
			</li>
			<li>
				<a href={href("/docs/configuration")} class="text-accent hover:underline">Configuration</a> — all reconnection options
			</li>
		</ul>
	</ContentSection>
</DocsPage>
