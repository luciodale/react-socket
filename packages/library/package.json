{
	"name": "@luciodale/react-socket",
	"version": "0.0.1",
	"author": "Lucio D'Alessandro",
	"repository": {
		"type": "git",
		"url": "https://github.com/luciodale/react-socket"
	},
	"main": "dist/react-socket.umd.js",
