{
	// Typechecks the test suite. The build config (tsconfig.json) excludes
	// __tests__ so tests never block emit — but vitest runs through esbuild,
	// which strips types without checking them. Without this config, type
	// errors in test files are caught by nothing. Wired into `bun run test`.
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"composite": false,
		"declaration": false,
		"declarationMap": false
	},
	"include": ["src"],
	"exclude": ["node_modules", "dist"]
}
